{{- /* Main-site article search. The legal library has its own title/chapter finder. */ -}}
{{- $pages := where .Site.RegularPages "Section" "in" (slice "posts" "daily" "hotspot-daily") -}}
{{- $result := slice -}}
{{- range $pages -}}
  {{- $data := dict "title" (.Title | htmlUnescape) "displayTitle" (partial "journal/display-title.html" . | htmlUnescape) "section" .Section "date" .Date "permalink" .RelPermalink "content" (.Plain | htmlUnescape) "tags" (.Params.tags | default slice) -}}
  {{- $result = $result | append $data -}}
{{- end -}}
{{ jsonify $result }}
