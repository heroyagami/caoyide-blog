{
  "version": "1.0",
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.2,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["zh"]
  },
  "email": {
    "enabled": false
  },
  "sources": {
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 80
    },
    "rss": [],
    "github": [],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "law",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 20,
          "min_score": 15
        },
        {
          "subreddit": "privacy",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20
        },
        {
          "subreddit": "cybersecurity",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 25
        }
      ],
      "users": [],
      "fetch_comments": 3
    }
  },
  "filtering": {
    "ai_score_threshold": 6.2,
    "time_window_hours": 48
  },
  "webhook": {
    "enabled": false
  }
}
